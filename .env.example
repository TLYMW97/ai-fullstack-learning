# 复制为 .env 并填入真实值（.env 已被 gitignore，不会入库）
# 详见 docs/progress-log.md 与 README.md

# 本地数据库连接串（PostgreSQL，跑在 Docker 容器里）
# 格式：postgresql://<用户>:<密码>@<主机>:<端口>/<库名>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blog?schema=public"

# 会话 Cookie 的 HMAC 签名密钥（改这个 = 所有人被强制登出）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# 极验 GeeTest v4（可选：不配则登录页滑块加载失败，登录会被 fail-closed 拒绝）
# captcha_id 前端公开；captcha_key 后端保密，绝不进前端/入库。
GEETEST_ID=""
GEETEST_KEY=""

# 邮箱验证码（QQ/163 SMTP）：发件邮箱 + SMTP 授权码（不是邮箱登录密码）
SMTP_USER=""
SMTP_PASS=""

# 腾讯云 COS（阶段 3 图片上传）：SecretKey 保密；Bucket 用完整名（含 APPID 后缀）
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION="ap-guangzhou"
# CDN 加速域名（可选，预留）：配了 CDN 后填加速域名（如 img.example.com），图片 URL 自动切到 CDN
COS_CDN_DOMAIN=""
