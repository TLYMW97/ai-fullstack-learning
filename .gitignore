# 依赖
node_modules/
.pnpm-store/

# 构建产物
.next/
out/
build/
dist/

# 环境变量（含密钥，绝不入库）
# 注意：这里刻意不写 .env*，否则 .env.example 这个模板文件也会被忽略掉
.env
.env.local
.env.*.local
.env.bak

# TypeScript / Next.js 生成物
*.tsbuildinfo
next-env.d.ts

# Prisma 生成的 Client 代码（由 schema 自动生成，不入库）
# 每次 prisma generate / migrate 都会重新生成，提交上去只会制造无意义的 diff
/lib/generated/prisma

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# 系统文件
.DS_Store
Thumbs.db

# WorkBuddy 项目数据（非代码，不入库）
.workbuddy/
