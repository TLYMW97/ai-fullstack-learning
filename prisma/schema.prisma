// Prisma Schema：整个数据库的"唯一真相来源"（single source of truth）。
//
// 传统开发流程是：先在数据库里 CREATE TABLE，然后手写 TypeScript 类型去对应表结构，
// 两边靠人肉保持同步，改了表忘了改类型就出 bug。
// Prisma 反过来：**你只写这个文件**，然后
//   1. `prisma migrate dev`  → 自动生成 SQL 并应用到数据库（表结构跟着这个文件走）
//   2. `prisma generate`     → 自动生成带完整类型的 Client（TS 类型跟着这个文件走）
// 数据库和代码的类型从此不可能对不上。

// ---------- generator：生成客户端代码 ----------
// Prisma 7 起默认是 `prisma-client`（ESM、产出可读的 TS 源码），
// 旧的 `prisma-client-js` 是打进 node_modules 的黑盒 JS，已不推荐。
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// ---------- datasource：连哪个数据库 ----------
// 连接串不写死在这里，而是从 .env 的 DATABASE_URL 读（见根目录 prisma7.config.ts）。
// 好处：本地连 Docker 的库、线上连云数据库，只换环境变量，schema 文件不用动。
datasource db {
  provider = "postgresql"
}

// ---------- model：表 ----------
// Post 表已跑通「改 schema → 生成迁移 → 读写数据」这条链路；下面的 User 表是同一套动作的重复。
model Post {
  // @id            = 主键
  // @default(autoincrement()) = 交给数据库自增，对应 PostgreSQL 的 SERIAL/IDENTITY
  id Int @id @default(autoincrement())

  // 不带 ? 就是 NOT NULL，必填
  title String

  // 带 ? 表示可以为 NULL；数据库列也相应可为 NULL
  content String?

  // @default(false) = 数据库列带 DEFAULT false，插入时不传就是 false
  published Boolean @default(false)

  // @default(now()) = 插入时自动填当前时间（由数据库层面兜底）
  createdAt DateTime @default(now())

  // @updatedAt = Prisma 在每次 update 时自动刷新这个字段，不用你手写
  updatedAt DateTime @updatedAt

  // 标签：PostgreSQL 的 text[] 数组，Prisma 用 String[] 表示。
  // 选数组而非独立 Tag 表 + 多对多：个人博客标签是「文章的分类标注」，
  // 不需要标签的独立生命周期（改名/合并/计数看板），一张表加个数组列最省事。
  // 真要标签管理页 / 跨文章聚合统计时，再拆 Tag 表不迟。
  tags String[] @default([])

  // 公开列表按 published 过滤 + createdAt 排序，加复合索引让查询走索引而非全表扫
  @@index([published, createdAt])
}

// ---------- model：用户/管理员 ----------
// 预留多用户：username 唯一作登录标识；email 可空唯一（以后注册 / 找回密码用）。
// 密码只存 scrypt 哈希（格式 scrypt$<salt>$<hash>），绝不明文。
// @@map("users")：显式指定表名。因为 User 是 PostgreSQL 保留字（SELECT USER 是关键字），
// 用默认表名 "User"（带引号）裸 SQL 很麻烦；复数 snake_case 也更符合 PG 惯例。
// 注意：Post 模型没写 @@map，所以它的默认表名就是 "Post" —— Prisma 默认表名=模型名，不会自动复数。
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
